# =====================================================================
# S.A.R.A.T.H.I. Autonomous AI Voice Assistant - Environment Configuration
# =====================================================================

ASSISTANT_NAME="SARATHI"
USER_NAME="Sir"

# LLM Providers (At least one required for Brain layer)
# Groq is recommended for ultra-low latency (<150ms TTFT)
GROQ_API_KEY="your-groq-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
DEFAULT_LLM_PROVIDER="groq"

# Speech-to-Text (STT)
# Options: "deepgram" (fastest, streaming WS) or "whisper" (local faster-whisper)
STT_PROVIDER="deepgram"
DEEPGRAM_API_KEY="your-deepgram-api-key-here"
LOCAL_WHISPER_MODEL="base.en"

# Text-to-Speech (TTS)
# Options: "edge_tts" (100% free, crisp British voice) or "elevenlabs" (Paul Bettany clone)
TTS_PROVIDER="edge_tts"
EDGE_TTS_VOICE="en-GB-RyanNeural"
ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"
ELEVENLABS_VOICE_ID="OOHcfRLzp0Mr7mSiXm7L"

# Wake Word Engine
# Options: "openwakeword" or "porcupine"
WAKE_WORD_ENGINE="openwakeword"
WAKE_WORD_NAME="hey_jarvis"
PICOVOICE_ACCESS_KEY="your-picovoice-access-key-here"

# Assistant Config
ASSISTANT_NAME="SARATHI"
USER_NAME="Sir"
AUDIO_INPUT_DEVICE_INDEX=""
AUDIO_OUTPUT_DEVICE_INDEX=""
VOICE_ACTIVITY_THRESHOLD=0.028
SILENCE_TIMEOUT_MS=450

# Latency Optimization Flags
ENABLE_LATENCY_METRICS=true
GROQ_REASONING_EFFORT="low"
ENABLE_LLM_LOW_LATENCY=true
ENABLE_RULE_FAST_PATH=true
ENABLE_PERSISTENT_HTTP_CLIENT=true
ENABLE_FLAC_COMPRESSION=true
GROQ_TIMEOUT_SEC=3.0
VAD_ENGINE="silero"
ENABLE_SPECULATIVE_STT=false
ENABLE_PIPELINED_TTS_QUEUE=true
ENABLE_EARLY_FILLERS=true

# Vision Engine
VISION_MODEL="llama-3.2-11b-vision-preview"
